# Copy to .env and adjust. Never commit a real .env.

# PostgreSQL (local demo credentials, not secrets for anything real)
POSTGRES_DB=privacy_agent
POSTGRES_USER=privacy_agent
POSTGRES_PASSWORD=change-me-local-only

# Privacy policy
PRIVACY_DOCUMENT_RETENTION_HOURS=24
PRIVACY_REDACTION_STYLE=BLOCK          # BLOCK (length-preserving) or LABEL ([REDACTED PERSON])
PRIVACY_EVALUATION_ENABLED=true

# Local model: "laya" (real model, ~850 MB download on first start) or "mock" (TEMPORARY stand-in, no ML)
PII_CLASSIFIER=laya
LAYA_THRESHOLD=0.5
LAYA_REGION=US                          # US, GB, CA, IN or SG
# CPU threads for the model. Leave empty locally; on a hosted CPU set it to about 2/3 of your vCPU quota.
# In containers torch otherwise uses the host's core count and gets throttled (Railway, 24 vCPU: 16 threads was ~5x faster).
LAYA_TORCH_THREADS=
LAYA_BATCH_SIZE=16

# Sign-in (the frontend is the only public entry point and forwards /api/* to the backend).
# Locally, sign-in is off unless AUTH_DISABLED=false. NEVER set AUTH_DISABLED on a hosted deployment.
AUTH_DISABLED=true
# Comma-separated "username=scrypt:..." entries. Create one with: node frontend/scripts/hash-password.mjs <username>
APP_USERS=
# At least 32 random characters, e.g. `openssl rand -base64 48`. Changing it signs everyone out.
SESSION_SECRET=
SESSION_TTL_HOURS=8
# Shared secret between frontend and backend (`openssl rand -hex 32`). Required when the backend runs with SPRING_PROFILES_ACTIVE=prod.
INTERNAL_API_TOKEN=
